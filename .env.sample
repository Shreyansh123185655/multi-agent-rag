# ==========================================
# Multi-Agent RAG System - Environment Variables
# ==========================================
# Instructions:
# 1. Fill in your actual keys below.
# 2. Save this file as ".env" (or upload it directly into the Streamlit UI).
# ==========================================

# 1. Groq API Key (powers the LLM routing and generation)
# Get this for free at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Astra DB Token (authenticates to your vector database)
# Get this at https://astra.datastax.com (starts with AstraCS:...)
ASTRA_DB_TOKEN=AstraCS:your_astra_db_token_here

# 3. Astra DB ID (tells the app which database to use)
# It looks like a UUID (e.g., 12345678-1234-1234-1234-123456789abc)
ASTRA_DB_ID=your_astra_db_id_here
